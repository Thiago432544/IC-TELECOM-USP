+OOMScoreAdjust=-900
+MemoryMax=96M
+CPUQuota=15%
+# eventos tambem vao para o journal (persistente): journalctl -u caixa-preta
+StandardOutput=journal
+StandardError=journal
+
+[Install]
+WantedBy=multi-user.target
